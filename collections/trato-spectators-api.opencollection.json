{
  "opencollection": "1.0.0",
  "info": {
    "name": "TRATO Contract Contracts Spectators API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Spectators",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the spectators of a contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://enterprise.api.trato.io/api/contracts/:contractID/spectators",
            "params": [
              {
                "name": "contractID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the spectators of a contract"
        },
        {
          "info": {
            "name": "Add a spectator to a contract",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://enterprise.api.trato.io/api/contracts/:contractID/spectators",
            "params": [
              {
                "name": "contractID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Add a spectator to a contract"
        },
        {
          "info": {
            "name": "Update a spectator",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://enterprise.api.trato.io/api/contracts/:contractID/spectators/:spectatorID",
            "params": [
              {
                "name": "contractID",
                "value": "",
                "type": "path"
              },
              {
                "name": "spectatorID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a spectator"
        },
        {
          "info": {
            "name": "Remove a spectator",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://enterprise.api.trato.io/api/contracts/:contractID/spectators/:spectatorID",
            "params": [
              {
                "name": "contractID",
                "value": "",
                "type": "path"
              },
              {
                "name": "spectatorID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a spectator"
        }
      ]
    }
  ],
  "bundled": true
}